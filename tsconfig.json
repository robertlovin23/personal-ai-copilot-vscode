{
	"compilerOptions": {
	  "target": "esnext",
	  "module": "commonjs",
	  "sourceMap": true,
	  "lib": ["esnext", "dom"],  // Add "dom" here
	  "moduleResolution": "node",
	  "outDir": "./out",
	  "strict": true,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "forceConsistentCasingInFileNames": true
	}
  }
  